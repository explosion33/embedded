# include "{{ header_path }}"

#include <cstdint>
#include <optional>
#include <iterator>


namespace {{ namespace }} {

constexpr bool IsUsartRxImpl(Usart usart, Pin pin) {
    switch (usart) {
        {% for usart in usarts %}
        case Usart::{{ usart.enum.enum_name }}:
            switch (pin) {
                {% for pin in usart.rx_pins %}
                case Pin::{{ pin.enum_name }}:
                    return true;
                {% endfor %}
                default:
                    return false;
            }
        {% endfor %}
    }
}

constexpr bool IsUsartTxImpl(Usart usart, Pin pin) {
    switch (usart) {
        {% for usart in usarts %}
        case Usart::{{ usart.enum.enum_name }}:
            switch (pin) {
                {% for pin in usart.tx_pins %}
                case Pin::{{ pin.enum_name }}:
                    return true;
                {% endfor %}
                default:
                    return false;
            }
        {% endfor %}
    }
    return false;
}

struct PinInfo {
    Port port;
    uint8_t idx;
    bool output;
};

constexpr PinInfo kPinInfo[] = {
{% for pin in pins %}
    PinInfo{Port::{{ pin.port_enum }}, {{ pin.pin_idx }}, {{ pin.output | string | lower}} }, // {{ pin.enum_name }}
{% endfor %}
};

const PinInfo* GetPinInfo(Pin pin) {
    const size_t i = static_cast<size_t>(pin);
    return i < std::size(kPinInfo) ? &kPinInfo[i] : nullptr;
}

std::optional<bool> SupportsOutput(Pin pin) {
    const PinInfo* info = GetPinInfo(pin);
    if (info == nullptr) {
        return std::nullopt;
    }
    return info->output;
}

std::optional<Port> GetPort(Pin pin) {
    const PinInfo* info = GetPinInfo(pin);
    if (info == nullptr) {
        return std::nullopt;
    }
    return info->port;
}

std::optional<uint8_t> GetPinIndex(Pin pin) {
    const PinInfo* info = GetPinInfo(pin);
    if (info == nullptr) {
        return std::nullopt;
    }
    return info->idx;
}

bool IsUsartTx(Usart usart, Pin pin) {
    return IsUsartTxImpl(usart, pin);
}

bool IsUsartRx(Usart usart, Pin pin) {
    return IsUsartRxImpl(usart, pin);
}

} // {{ namespace }}