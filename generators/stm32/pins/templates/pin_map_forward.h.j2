#pragma once
#include <cstdint>
#include <optional>

namespace {{ namespace }} {

// Non-ordered enumeration over all pins for this target.
enum class Pin : uint8_t;

// Enumeration over all ports supported by this target. Ports are numbered
// alpha-numerically by port letter, and the enum supports gaps.
enum class Port : uint8_t;

// Enumeration over all USARTs provided by this target. USARTs are numbered
// by USART index.
enum class Usart : uint8_t;

// Returns true if the pin supports GPIO Output. nullopt for invalid pins.
std::optional<bool> SupportsOutput(Pin pin);

// Returns the port for the provided `pin`, or nullopt if the pin is not valid.
std::optional<Port> GetPort(Pin pin);

// Returns the pin index for the provided `pin`, or nullopt if the pin is not valid.
std::optional<uint8_t> GetPinIndex(Pin pin);

// Returns true if the provided Pin is a TX pin on the supplied USART.
bool IsUsartTx(Usart usart, Pin pin);

// Returns true if the provided Pin is a RX pin on the supplied USART.
bool IsUsartRx(Usart usart, Pin pin);

} // {{ namespace }}