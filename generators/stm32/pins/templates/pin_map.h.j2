#pragma once
#include <cstdint>
#include <optional>

namespace {{ namespace }} {

// Non-ordered enumeration over all pins for this target.
enum class Pin : uint8_t {
{% for pin in pins %}
    {{ pin.enum_name }}, // {{ pin.full_name }}
{% endfor %}
};

// Enumeration over all ports supported by this target. Ports are numbered
// alpha-numerically by port letter, and the enum supports gaps.
enum class Port : uint8_t {
{% for port in ports %}
    {{ port.enum_name }} = {{ port.enum_value }},
{% endfor %}
};

// Enumeration over all UART peripherals supported by this target.
enum class Uart : uint8_t {
{% for uart in uarts %}
    {{ uart.enum.enum_name }} = {{ uart.enum.enum_value }},
{% endfor %}
};

// Returns the port for the provided `pin`, or nullopt if the pin is not valid.
constexpr Port GetPort(Pin pin) {
    switch (pin) {
        {% for pin in pins %}
            case Pin::{{ pin.enum_name }}: return Port::{{ pin.port_enum }};
        {% endfor %}
    }
}

// Returns the pin index for the provided `pin`, or nullopt if the pin is not valid.
constexpr uint8_t GetPinIndex(Pin pin) {
    switch (pin) {
        {% for pin in pins %}
            case Pin::{{ pin.enum_name }}: return {{ pin.pin_idx }};
        {% endfor %}
    }
}

// Returns the alternate function mapping to the provided uart for a TX pin.
constexpr std::optional<uint8_t> GetUartTxAf(Uart uart, Pin pin) {
    switch (uart) {
        {% for uart in uarts %}
        case Uart::{{ uart.enum.enum_name }}: {
            switch (pin) {
                {% for pin in uart.tx_pins %}
                case Pin::{{ pin.enum_name }}: return {{ pin.enum_value }};
                {% endfor %}
            }
        }
        {% endfor %}
    }
    return std::nullopt;
}


// Returns the alternate function mapping to the provided uart for a RX pin.
constexpr std::optional<uint8_t> GetUartRxAf(Uart uart, Pin pin) {
    switch (uart) {
        {% for uart in uarts %}
        case Uart::{{ uart.enum.enum_name }}: {
            switch (pin) {
                {% for pin in uart.rx_pins %}
                case Pin::{{ pin.enum_name }}: return {{ pin.enum_value }};
                {% endfor %}
            }
        }
        {% endfor %}
    }
    return std::nullopt;
}
} // {{ namespace }}