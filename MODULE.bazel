PYTHON_VERSION = "3.14"

# STM32 / ARM Toolchain version pins.
ARM_TOOLCHAIN_VERSION = "14.3.rel1"

CMSIS_CORE_VERSION = "5.9.0_20250520"

CMSIS_DEVICE_F4_VERSION = "2.6.11"

STM32F4XX_HAL_DRIVER_VERSION = "1.8.5"

FREERTOS_KERNEL_VERSION = "11.3.1"

BAZEL_COMPILE_COMMANDS_VERSION = "0.22.4"

# PyOCD Flashing Target Pack versions.
STM32F4XX_DFP_VERSION = "3.1.1"

module(
    name = "embedded",
    version = "0.1.0",
)

bazel_dep(name = "abseil-cpp", version = "20260526.0")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1")
bazel_dep(name = "magic_enum", version = "0.9.8")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_python", version = "2.3.3")

single_version_override(
    module_name = "abseil-cpp",
    version = "20260526.0",
)

# Don't auto generate __init__.py files for python packages.
rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)

# The uv toolchain, used only by `bazel run //:uv.update` to regenerate uv.lock.
uv = use_extension(
    "@rules_python//python/uv:uv.bzl",
    "uv",
    dev_dependency = True,
)
uv.configure(version = "0.12.15")

# Turns uv.lock into the `@pypi` repo, so third-party deps are labels like
# `@pypi//requests`. No pip involved: wheel URLs and hashes come straight
# out of uv.lock and are fetched by the Bazel downloader.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = PYTHON_VERSION,
    uv_lock = "//:uv.lock",
)
use_repo(pip, "pypi")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# Fetch the CMSIS Device Family Pack used by pyOCD to describe STM32F4 targets.
http_file(
    name = "stm32f4xx_dfp",
    downloaded_file_path = "STM32F4xx_DFP.pack",
    sha256 = "345231106fe697df24bbe9133aeeec1b0383d7891c4adf4f47bbb8b478e9f2f0",
    urls = ["https://www.keil.com/pack/Keil.STM32F4xx_DFP.%s.pack" % STM32F4XX_DFP_VERSION],
)

# Fetch the bare-metal arm cross compiler.
http_archive(
    name = "arm_none_eabi",
    build_file = "//fw/platform/toolchains/arm_none_eabi:external.BUILD",
    sha256 = "8f6903f8ceb084d9227b9ef991490413014d991874a1e34074443c2a72b14dbd",
    strip_prefix = "arm-gnu-toolchain-%s-x86_64-arm-none-eabi" % ARM_TOOLCHAIN_VERSION,
    url = ("https://developer.arm.com/-/media/Files/downloads/gnu/{v}/binrel/" +
           "arm-gnu-toolchain-{v}-x86_64-arm-none-eabi.tar.xz").format(v = ARM_TOOLCHAIN_VERSION),
)

# Fetch the STM CMSIS / HAL / LL drivers.
http_archive(
    name = "cmsis_core",
    build_file = "//fw/platform/external:cmsis_core.BUILD",
    sha256 = "da3e50301da157f322dba1d63bab3851c7ac8d793e3b13d7f621270d130aebd3",
    strip_prefix = "cmsis-core-%s" % CMSIS_CORE_VERSION,
    url = "https://github.com/STMicroelectronics/cmsis-core/archive/refs/tags/v%s.tar.gz" % CMSIS_CORE_VERSION,
)

http_archive(
    name = "cmsis_device_f4",
    build_file = "//fw/platform/external:cmsis_device_f4.BUILD",
    sha256 = "c0dce054b1cd53135a3763c97b6cdef02a96d2495c78d8677cdbf37114d47a0c",
    strip_prefix = "cmsis-device-f4-%s" % CMSIS_DEVICE_F4_VERSION,
    url = "https://github.com/STMicroelectronics/cmsis_device_f4/archive/refs/tags/v%s.tar.gz" % CMSIS_DEVICE_F4_VERSION,
)

http_archive(
    name = "stm32f4xx_hal_driver",
    build_file = "//fw/platform/external:stm32f4xx_hal_driver.BUILD",
    sha256 = "1d792fa91a15531b181aadbbd794e7c086650036406ad71932507f0cc8b7ca56",
    strip_prefix = "stm32f4xx-hal-driver-%s" % STM32F4XX_HAL_DRIVER_VERSION,
    url = "https://github.com/STMicroelectronics/stm32f4xx_hal_driver/archive/refs/tags/v%s.tar.gz" % STM32F4XX_HAL_DRIVER_VERSION,
)

# Fetch the FreeRTOS kernel.
http_archive(
    name = "freertos_kernel",
    build_file = "//fw/platform/external:freertos_kernel.BUILD",
    sha256 = "da9c9567368db9b2f1d053a344e7892587af6ee50398f0f14fba53405cc7c041",
    strip_prefix = "FreeRTOS-Kernel-%s" % FREERTOS_KERNEL_VERSION,
    url = "https://github.com/FreeRTOS/FreeRTOS-Kernel/archive/refs/tags/V%s.tar.gz" % FREERTOS_KERNEL_VERSION,
)

http_archive(
    name = "bazel_compile_commands",
    build_file = "//tools/linting:bazel_compile_commands.BUILD",
    sha256 = "bb162adaefb282a9e4f0f399fe6223d1d2fe3740518148c1ca8f6f81db4003f6",
    url = ("https://github.com/kiron1/bazel-compile-commands/releases/download/" +
           "bazel-compile-commands-v{v}/bazel-compile-commands_{v}-linux_amd64.zip").format(
        v = BAZEL_COMPILE_COMMANDS_VERSION,
    ),
)

register_toolchains("//fw/platform/toolchains/arm_none_eabi:arm_none_eabi_toolchain")

stm32_pins = use_extension("//:stm32_xml.bzl", "stm32_pins")
stm32_pins.download(file_name = "STM32F446R(C-E)Tx.xml")
use_repo(stm32_pins, "STM32F446R_C_E_Tx")
